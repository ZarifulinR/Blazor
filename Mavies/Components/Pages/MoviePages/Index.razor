@page "/movies"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Mavies
@using Mavies.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Mavies.Data.MaviesContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>
<div>   
    <form action="/movies" data-enhansce data-permanent>
        <input type="search" name="TitleFilter"/>
        <input type="submit" value="Search"/>
    </form>

</div>
<p>
    <a href="movies/create">Create New</a>
</p>

<QuickGrid Class="table" Items="FiltredMovies" Pagination="pagination">
    <PropertyColumn Property="movie => movie.Title" />
    <PropertyColumn Property="movie => movie.ReleasDate" />
    <PropertyColumn Property="movie => movie.Genre" />
    <PropertyColumn Property="movie => movie.Price" />

    <TemplateColumn Context="movie">
        <a href="@($"movies/edit?id={movie.Id}")">Edit</a> |
        <a href="@($"movies/details?id={movie.Id}")">Details</a> |
        <a href="@($"movies/delete?id={movie.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>
    <Paginator State="pagination"/>

@code {
    private MaviesContext context = default!;
    [SupplyParameterFromQuery]
    private string? TitleFilter { get; set; }
    private IQueryable<Movie> FiltredMovies =>
            context.Movie.Where(m => m.Title!.Contains(TitleFilter ?? string.Empty));
    PaginationState pagination = new PaginationState { ItemsPerPage = 3 };

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
