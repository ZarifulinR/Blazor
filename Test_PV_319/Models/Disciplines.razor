@page "/discipline"
@inject Pd319Context Db

<h3>Список дисциплин</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
        </tr>
    </thead>
    <tbody>
        @if (disciplines is not null)
        {
            @foreach (var d in disciplines)
            {
                <tr>
                    <td>@d.DisciplineId</td>
                    <td>@d.DisciplineName</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<Discipline> disciplines = new();

    protected override void OnInitialized()
    {
        disciplines = Db.Disciplines.ToList();
    }
}
